# Java orchestrator image for Kubernetes/OpenShift. OpenHands runs only in its separate Job image.
FROM node:22-bookworm AS node
FROM eclipse-temurin:21-jre-noble

COPY --from=node /usr/local /usr/local
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && useradd --create-home --uid 10001 agent \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY target/bug-fixer-agent-0.1.0-SNAPSHOT.jar /app/bug-fixer-agent.jar
COPY runtime/investigation-knowledge.md /app/runtime/investigation-knowledge.md
RUN chown -R agent:agent /app
USER 10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/bug-fixer-agent.jar"]

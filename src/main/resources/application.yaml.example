server:
  port: 8080

# Copy to application.yaml for local development. Keep actual credentials only
# in application.yaml, which is ignored by Git.
bugfixer:
  jira-webhook-secret: local-test-secret
  max-webhook-bytes: 1048576
  worker-enabled: false
  agent-ready-status: Ready for Agent
  target-repository: ../debugRepo
  target-repository-name: debugRepo
  target-branch: main
  openhands-enabled: false
  # Legacy local switch. Prefer openhands-execution-mode below.
  openhands-container-enabled: false
  # LOCAL runs Python within this process; DOCKER uses Docker Desktop; KUBERNETES creates one Job per attempt.
  openhands-execution-mode: LOCAL
  openhands-container-image: bug-fixer-openhands:0.1.1
  # Kubernetes/OpenShift settings. The Java deployment and each OpenHands Job mount this same PVC.
  openhands-kubernetes-namespace: bug-fixer
  openhands-kubernetes-service-account: bug-fixer-worker
  # openhands-kubernetes-secret-name: bug-fixer-model
  # openhands-workspace-claim: bug-fixer-workspace
  openhands-job-ttl-seconds: 300
  # Required when KUBERNETES mode is enabled: the mounted shared workspace root.
  # workspace-root: /workspace-root
  openhands-python-binary: python3
  openhands-worker-script: runtime/openhands_worker.py
  # Supported values: GEMINI, GROQ. The provider is selected only from trusted configuration.
  openhands-provider: GEMINI
  openhands-model: gemini-3.5-flash
  # Defaults to adk-api-key when blank.
  openhands-gemini-api-key:
  groq-base-url: https://api.groq.com/openai/v1
  groq-api-key:
  # Root connector URL; the service starts a loopback-only bridge for Gemini.
  gemini-connector-base-url:
  gemini-vertex-project:
  gemini-vertex-location:
  gemini-proxy-port: 8787
  max-fix-attempts: 3
  openhands-timeout-minutes: 20
  adk-enabled: false
  adk-model: gemini-2.5-flash
  adk-api-key:
  adk-base-url:
  adk-authorization:
  adk-client-id:
  adk-client-secret:
  validation-profile: NPM_CI_TEST
  local-simulation-enabled: true
  publishing-enabled: false
  github-repository: asherplotnik/debugRepo
  # github-token: paste-a-fine-grained-token-here
  # Bitbucket Data Center mode. Set all three values to clone from, push to, and create a PR in one approved repository.
  # bitbucket-base-url: https://bitbucket.dev.local:8443
  # bitbucket-project-key: DMS # Allowed values: DMS, DIRM
  # bitbucket-token: store this only in a local ignored file or the bank secret manager
  investigation-knowledge-file: runtime/investigation-knowledge.md

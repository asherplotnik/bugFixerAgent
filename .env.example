# Required for signed Jira Cloud admin webhooks.
JIRA_WEBHOOK_SECRET=replace-with-a-high-entropy-secret
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=agent@example.com
JIRA_API_TOKEN=replace-with-a-read-only-jira-api-token

# Local receiver settings.
SERVER_PORT=8080
MAX_WEBHOOK_BYTES=1048576
WORKER_ENABLED=false
AGENT_READY_STATUS=Ready for Agent

# The repository is chosen only from this trusted local configuration, never from Jira text.
TARGET_REPOSITORY=C:/path/to/approved/repository
TARGET_REPOSITORY_NAME=approved-service
TARGET_BRANCH=main

# No code-changing process runs until explicitly enabled.
OPENHANDS_ENABLED=false
OPENHANDS_CONTAINER_IMAGE=asherplotnik/bug-fixer-openhands:0.1.0
OPENHANDS_KUBERNETES_NAMESPACE=bug-fixer
OPENHANDS_KUBERNETES_SERVICE_ACCOUNT=bug-fixer-worker
OPENHANDS_KUBERNETES_SECRET_NAME=bug-fixer-model
OPENHANDS_WORKSPACE_CLAIM=bug-fixer-workspace
WORKSPACE_ROOT=/workspace-root
OPENHANDS_PROVIDER=GEMINI
OPENHANDS_MODEL=gemini-3.5-flash
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENHANDS_TIMEOUT_MINUTES=20
MAX_FIX_ATTEMPTS=3
ADK_ENABLED=false
ADK_MODEL=gemini-2.5-flash
ADK_API_KEY=replace-with-connector-api-key
ADK_BASE_URL=https://your-approved-gemini-connector
ADK_AUTHORIZATION=Bearer replace-with-short-lived-jwt-if-required
ADK_CLIENT_ID=replace-with-client-id-if-required
ADK_CLIENT_SECRET=replace-with-client-secret-if-required

# Supported values: NONE, MAVEN_VERIFY, GRADLE_CHECK, NPM_TEST, NPM_CI_TEST
VALIDATION_PROFILE=NONE
